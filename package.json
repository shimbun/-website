{
  "name": "compass-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:content": "node scripts/check-content.mjs",
    "check:release": "node scripts/check-content.mjs --release",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run check:content && npm run test:e2e",
    "images": "node scripts/generate-images.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
