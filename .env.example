# ---- ビルド時（Cloudflare Pages の環境変数に設定） ----
SITE_URL=https://www.example.com          # 本番ドメイン
PUBLIC_SITE_ENV=staging                   # production にすると index 許可・要確認ハイライト非表示
PUBLIC_GTM_ID=                            # 例: GTM-XXXXXXX
PUBLIC_TURNSTILE_SITE_KEY=                # Cloudflare Turnstile サイトキー
PUBLIC_TIMEREX_URL=                       # 日程調整ページURL（完了ページ・自動返信で使用）

# ---- 実行時（Pages Functions のシークレット） ----
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
MAIL_FROM=no-reply@example.com
MAIL_TO=info@example.com
