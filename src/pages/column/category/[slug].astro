---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ColumnCard from '../../../components/ColumnCard.astro';
import FinalCta from '../../../components/FinalCta.astro';
import CtaButton from '../../../components/CtaButton.astro';
import { columnCategories, type ColumnCategory } from '../../../data/columnCategories';
import { getService } from '../../../data/services';

export function getStaticPaths() {
  return columnCategories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}
const { category } = Astro.props as { category: ColumnCategory };
const posts = (await getCollection('columns', (c) => !c.data.draft && c.data.category === category.slug))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const service = getService(category.service)!;
const crumbs = [{ label: '中学受験コラム', href: '/column/' }, { label: category.name }];
---
<BaseLayout
  title={`${category.name}｜中学受験コラム｜COMPASS`}
  description={`${category.description}中学受験の悩みを第三者の視点で整理するコラムです。`}
  pageType="column"
  crumbs={crumbs}
  noindex={posts.length < 5}
>
  <PageHeader title={category.name} eyebrow="COLUMN" crumbs={crumbs} summary={category.description} />
  <section class="section">
    <div class="container">
      {posts.length > 0 ? <div class="grid grid--3">{posts.map((p) => <ColumnCard entry={p} />)}</div> : <p class="empty-state">このカテゴリの記事は準備中です。</p>}
      <div class="card mt-2 center">
        <p><strong>{service.name}</strong>：{service.catch}</p>
        <CtaButton location="column_category" label="サービス内容を見る" href={`/services/${service.slug}/`} variant="secondary" />
      </div>
    </div>
  </section>
  <FinalCta topic={service.slug} />
</BaseLayout>
