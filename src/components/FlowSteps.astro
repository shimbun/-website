---
import { site } from '../config/site';
const steps = [
  { t: 'ご相談のお申し込み', d: `フォームから、お子さまの学年とご相談したいことをお送りください。内容がまとまっていなくても大丈夫です。${site.consultation.replyWithin}にご連絡し、日程を調整します。` },
  { t: 'ヒアリング', d: `現在の学年、通っている塾、成績、ご家庭の方針、お子さまの様子などを伺います。模試の結果などがあれば、より具体的にお話しできます（任意）。` },
  { t: '分析', d: '伺った内容と資料をもとに、課題と、その背景にある原因を整理します。' },
  { t: '戦略のご提案', d: '優先順位をつけた進め方と、選択肢ごとのメリット・注意点をお伝えします。最終的な判断はご家庭で行っていただけます。' },
  { t: '継続支援', d: '継続をご希望の場合は、定期的に状況を確認し、計画を見直します。1回のご相談で終了することもできます。', optional: true },
];
---
<ol class="steps">
  {steps.map((s) => (
    <li>
      <h3>{s.t}{s.optional && <span class="step-optional">ご希望の方のみ</span>}</h3>
      <p>{s.d}</p>
    </li>
  ))}
</ol>
